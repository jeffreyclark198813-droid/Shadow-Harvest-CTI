UIF-OS v4 — Universal Intelligence Data Connector & Scientific Extraction Configuration

Provider-Agnostic / Public-Data / API-Orchestrated / Provenance-Preserving Configuration

# ==============================================================================
# UIF-OS v4
# UNIVERSAL INTELLIGENCE DATA CONNECTOR + SCIENTIFIC EXTRACTION CONFIGURATION
# ==============================================================================
#
# Design objectives:
#   - Public/lawful data acquisition
#   - Provider-agnostic connectors
#   - Zero hard-coded secrets
#   - Runtime capability discovery
#   - T0 immutable evidence
#   - T1 deterministic feature generation
#   - T2 probabilistic reasoning
#   - Full provenance and traceability
#   - Retry/backoff/circuit breaking
#   - Rate-limit awareness
#   - Response caching
#   - Schema normalization
#   - Source trust weighting
#   - Temporal integrity
#   - Deterministic replay
#   - Cost/quota governance
#
# SECURITY:
#   Never commit real credentials.
#   Never place API keys in client-side JavaScript.
#   Never log Authorization headers, API keys, cookies, or tokens.
#   Use runtime secrets / environment injection.
#
# DATA POLICY:
#   PUBLIC_DATA_ONLY=true means the connector layer may consume only
#   legitimately accessible public/open data.
#
# ==============================================================================


# ==============================================================================
# 01. APPLICATION IDENTITY
# ==============================================================================

APP_NAME="UIF-OS"
APP_VERSION="4.1.0"
APP_ENV="production"

APP_URL="${APP_URL}"
APP_HOST="0.0.0.0"
APP_PORT="8080"

API_PREFIX="/api/v1"

NODE_ENV="production"

LOG_LEVEL="info"
LOG_FORMAT="json"

TIMEZONE="UTC"

INSTANCE_ID=""
DEPLOYMENT_ID=""


# ==============================================================================
# 02. GEMINI / GOOGLE AI
# ==============================================================================

# Inject from the runtime secret manager / AI Studio Secrets.
#
# DO NOT replace this with a literal credential.
#
GEMINI_API_KEY="${GEMINI_API_KEY}"

GEMINI_ENABLED="true"

GEMINI_PROVIDER="google"

GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com"

# Select models through configuration rather than embedding model names
# throughout application code.
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

GEMINI_REASONING_ENABLED="true"
GEMINI_STRUCTURED_OUTPUT_ENABLED="true"
GEMINI_EMBEDDING_ENABLED="true"

# Never assume a model has a free quota.
GEMINI_FREE_TIER_ASSUMED="false"

# Runtime capability discovery.
GEMINI_CAPABILITY_DISCOVERY="true"

# Quota protection.
GEMINI_MAX_REQUESTS_PER_MINUTE="10"
GEMINI_MAX_REQUESTS_PER_DAY="1000"

GEMINI_MAX_INPUT_TOKENS="1000000"
GEMINI_MAX_OUTPUT_TOKENS="8192"

GEMINI_REQUEST_TIMEOUT_MS="60000"

GEMINI_MAX_RETRIES="5"

GEMINI_RETRY_BASE_MS="500"
GEMINI_RETRY_MAX_MS="30000"

GEMINI_CIRCUIT_BREAKER_ENABLED="true"
GEMINI_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
GEMINI_CIRCUIT_BREAKER_RESET_MS="60000"

GEMINI_RESPONSE_CACHE_ENABLED="true"
GEMINI_RESPONSE_CACHE_TTL_SECONDS="3600"

# Cost controls.
GEMINI_COST_GUARD_ENABLED="true"
GEMINI_DAILY_COST_LIMIT_USD="0"

# Zero means:
#   do not automatically incur billable usage.
#
# Set explicitly > 0 only when the operator intentionally enables paid usage.


# ==============================================================================
# 03. APPLICATION URL / CALLBACK SECURITY
# ==============================================================================

APP_URL_REQUIRED="true"

OAUTH_CALLBACK_BASE_URL="${APP_URL}"

TRUST_PROXY="true"

CORS_ENABLED="true"

CORS_ALLOWED_ORIGINS="${APP_URL}"

CSRF_PROTECTION_ENABLED="true"

SECURE_COOKIES="true"

SAME_SITE_COOKIES="lax"


# ==============================================================================
# 04. GLOBAL DATA ACQUISITION POLICY
# ==============================================================================

DATA_ACQUISITION_ENABLED="true"

PUBLIC_DATA_ONLY="true"

LAWFUL_ACCESS_ONLY="true"

TERMS_COMPLIANCE_REQUIRED="true"

ROBOTS_POLICY_RESPECTED="true"

RATE_LIMITS_RESPECTED="true"

AUTH_REQUIRED_FOR_PRIVATE_DATA="true"

PRIVATE_DATA_CONNECTORS_ENABLED="false"

CLASSIFIED_DATA_CONNECTORS_ENABLED="false"

RESTRICTED_DATA_CONNECTORS_ENABLED="false"

CREDENTIAL_STEALING_CONNECTORS_ENABLED="false"

SURVEILLANCE_CONNECTORS_ENABLED="false"

UNAUTHORIZED_INTRUSION_CONNECTORS_ENABLED="false"


# ==============================================================================
# 05. INTELLIGENCE TAXONOMY
# ==============================================================================

INTELLIGENCE_DOMAINS="OSINT,SOCMINT,GEOINT,CTI,NETWORK_INTELLIGENCE,ECONOMIC,MARITIME,AVIATION,SCIENCE_TECHNOLOGY,HUMANITARIAN,GOVERNMENT,MEDIA,KNOWLEDGE_GRAPH"

MILSEC_DOMAIN_ENABLED="true"
OPSEC_ANALYTICS_ENABLED="true"
GOVSEC_DOMAIN_ENABLED="true"


# ==============================================================================
# 06. CONNECTOR REGISTRY
# ==============================================================================

DATA_SOURCE_REGISTRY_MODE="ACTIVE"

CONNECTOR_DISCOVERY_ENABLED="true"

CONNECTOR_HEALTHCHECK_ENABLED="true"

CONNECTOR_CAPABILITY_DISCOVERY_ENABLED="true"

CONNECTOR_AUTO_DISABLE_ON_FAILURE="true"

CONNECTOR_FAILURE_THRESHOLD="5"

CONNECTOR_RECOVERY_INTERVAL_SECONDS="300"


# ==============================================================================
# 07. SUPPORTED PROTOCOLS
# ==============================================================================

SUPPORTED_PROTOCOLS="REST,GRAPHQL,RSS,ATOM,JSON,XML,CSV,STIX_2_1,TAXII_2_1,WMS,WFS,WEBHOOK,SSE"


# ==============================================================================
# 08. UNIVERSAL CONNECTOR RUNTIME
# ==============================================================================

CONNECTOR_TIMEOUT_MS="30000"

CONNECTOR_CONNECT_TIMEOUT_MS="10000"

CONNECTOR_MAX_RESPONSE_BYTES="52428800"

CONNECTOR_MAX_RETRIES="4"

CONNECTOR_RETRY_ENABLED="true"

CONNECTOR_EXPONENTIAL_BACKOFF="true"

CONNECTOR_JITTER_ENABLED="true"

CONNECTOR_CIRCUIT_BREAKER_ENABLED="true"

CONNECTOR_RESPONSE_CACHE_ENABLED="true"

CONNECTOR_CACHE_TTL_SECONDS="900"

CONNECTOR_DEDUPLICATION_ENABLED="true"

CONNECTOR_CONTENT_HASH_ENABLED="true"

CONNECTOR_ETAG_ENABLED="true"

CONNECTOR_LAST_MODIFIED_ENABLED="true"


# ==============================================================================
# 09. NORMALIZATION
# ==============================================================================

NORMALIZATION_ENABLED="true"

NORMALIZATION_SCHEMA_VERSION="4.1"

CANONICAL_TIMEZONE="UTC"

NORMALIZE_UNICODE="true"

NORMALIZE_URLS="true"

NORMALIZE_DOMAINS="true"

NORMALIZE_IP_ADDRESSES="true"

NORMALIZE_COUNTRY_CODES="true"

NORMALIZE_ISO8601_TIMESTAMPS="true"

NORMALIZE_LANGUAGE_CODES="true"

NORMALIZE_CURRENCY_CODES="true"

NORMALIZE_GEOCOORDINATES="true"

NORMALIZE_IDENTIFIERS="true"


# ==============================================================================
# 10. T0 — IMMUTABLE OBSERVATION LAYER
# ==============================================================================

T0_ENABLED="true"

T0_IMMUTABLE="true"

T0_APPEND_ONLY="true"

T0_EVENT_ID_REQUIRED="true"

T0_SOURCE_ID_REQUIRED="true"

T0_SOURCE_TIMESTAMP_REQUIRED="true"

T0_INGEST_TIMESTAMP_REQUIRED="true"

T0_CONTENT_HASH_REQUIRED="true"

T0_PROVENANCE_REQUIRED="true"

T0_RAW_PAYLOAD_PRESERVED="true"

T0_RAW_RESPONSE_ARCHIVE_ENABLED="true"

T0_SCHEMA_VERSION="4.1"


# ==============================================================================
# 11. T1 — DETERMINISTIC ANALYTICS
# ==============================================================================

T1_ENABLED="true"

T1_DETERMINISTIC="true"

T1_REPLAYABLE="true"

T1_FEATURE_VERSIONING="true"

T1_STATISTICS_ENABLED="true"

T1_ENTITY_RESOLUTION_ENABLED="true"

T1_GRAPH_FEATURES_ENABLED="true"

T1_TEMPORAL_FEATURES_ENABLED="true"

T1_GEO_FEATURES_ENABLED="true"

T1_TEXT_FEATURES_ENABLED="true"

T1_EMBEDDING_FEATURES_ENABLED="true"


# ==============================================================================
# 12. T2 — PROBABILISTIC REASONING
# ==============================================================================

T2_ENABLED="true"

T2_NEVER_OVERWRITE_T0="true"

T2_NEVER_OVERWRITE_T1="true"

T2_PROVENANCE_REQUIRED="true"

T2_MODEL_VERSION_REQUIRED="true"

T2_CONFIDENCE_REQUIRED="true"

T2_UNCERTAINTY_REQUIRED="true"

T2_HYPOTHESIS_TRACKING_ENABLED="true"

T2_BAYESIAN_FUSION_ENABLED="true"

T2_GRAPH_REASONING_ENABLED="true"

T2_ANOMALY_REASONING_ENABLED="true"


# ==============================================================================
# 13. EVENT MODEL
# ==============================================================================

ATOMIC_EVENT_SCHEMA="AtomicEvent"

ATOMIC_EVENT_REQUIRED_FIELDS="event_id,event_time,ingest_time,source_system,source_trust,entity_ids,entity_type,signal_type,payload,observation_confidence"

OBSERVATION_CONFIDENCE_MIN="0"
OBSERVATION_CONFIDENCE_MAX="1"

SOURCE_TRUST_MIN="0"
SOURCE_TRUST_MAX="1"


# ==============================================================================
# 14. ENTITY RESOLUTION
# ==============================================================================

ENTITY_RESOLUTION_ENABLED="true"

ENTITY_RESOLUTION_MODE="HYBRID"

ENTITY_DETERMINISTIC_MATCHING="true"

ENTITY_PROBABILISTIC_MATCHING="true"

ENTITY_CANONICALIZATION="true"

ENTITY_ALIAS_TRACKING="true"

ENTITY_TEMPORAL_BOUNDS="true"

ENTITY_PROVENANCE="true"

ENTITY_CONFIDENCE="true"

ENTITY_ENTROPY="true"

ENTITY_MERGE_REVIEW_THRESHOLD="0.90"

ENTITY_AUTO_MERGE_THRESHOLD="0.98"

ENTITY_COLLISION_DETECTION="true"


# ==============================================================================
