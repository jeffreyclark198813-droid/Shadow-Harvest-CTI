DATA_MINIMIZATION_ENABLED="true"

UNNECESSARY_PII_COLLECTION="false"

SENSITIVE_DATA_DEFAULT_DENY="true"

PURPOSE_LIMITATION_ENABLED="true"

RETENTION_POLICY_REQUIRED="true"

RETENTION_PERIOD_REQUIRED="true"

