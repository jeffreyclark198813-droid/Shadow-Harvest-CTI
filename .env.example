# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# UNIVERSAL INTELLIGENCE DATA SOURCE API ORCHESTRATION CONFIGURATION
# ==============================================================================
# Provider-agnostic architecture for integrating public-facing intelligence,
# security, geospatial, event, registry, and open-source data APIs.
#
# All sources are normalized into a common intelligence-domain schema.
# Classified, restricted, or non-public systems are excluded.
# ==============================================================================

# ------------------------------------------------------------------------------
# INTELLIGENCE DOMAIN ENUMERATION
# ------------------------------------------------------------------------------
INTELLIGENCE_DOMAINS="OSINT,SOCMINT,GEOINT,MILSEC,OPSEC,GOVSEC,GDELT,EXTERNAL_REGISTRY"

# ------------------------------------------------------------------------------
# CANONICAL DATA SOURCE REGISTRY CONFIGURATION
# ------------------------------------------------------------------------------
# OSINT: Open Source Intelligence (PUBLIC_DATA, WEB_APIS, RSS, DOCUMENTS, DATASETS)
# SOCMINT: Social Media Intelligence (PUBLIC_SOCIAL_DATA, PUBLIC_APIS, OPEN_DATA, ARCHIVES)
# GEOINT: Geospatial Intelligence (GEOSPATIAL_DATA, SATELLITE_DATA, GIS_APIS, MAP_SERVICES, OPEN_COORDINATES)
# MILSEC: Military Security Context (PUBLIC_DEFENSE_INFORMATION, PUBLICATIONS, REPORTS, OPEN_ADVISORIES)
# OPSEC: Operational Security Signals (SECURITY_ANALYTICS_CONTEXT, PUBLIC_REPORTS, RISK_INDICATORS, DOCUMENT_ANALYSIS)
# GOVSEC: Government Security Feeds (GOVERNMENT_PUBLICATIONS, ADVISORIES, BULLETINS, OPEN_ALERTS)
# GDELT: Global Database of Events, Language, and Tone (GLOBAL_EVENT_INTELLIGENCE, EVENT_STREAMS, MEDIA_ANALYSIS, LANGUAGE_PROCESSING)
# EXTERNAL_REGISTRY: External Institutional Dataset Registry (UNKNOWN_OR_CUSTOM_DATASET, API_CONNECTORS, CSV, JSON, STIX, OPEN_DATASETS)

DATA_SOURCE_REGISTRY_MODE="ACTIVE"

# ------------------------------------------------------------------------------
# API CONNECTOR FRAMEWORK
# ------------------------------------------------------------------------------
API_CONNECTOR_MODE="MULTI_PROVIDER"
SUPPORTED_PROTOCOLS="REST,GRAPHQL,RSS,ATOM,JSON,XML,CSV,STIX_2_1,TAXII,WMS,WFS,WEBHOOK"

# ------------------------------------------------------------------------------
# NATO PUBLIC INFORMATION CONNECTORS
# ------------------------------------------------------------------------------
NATO_PUBLIC_API="PUBLIC_INFORMATION"
NATO_API_ENDPOINT=""

# ------------------------------------------------------------------------------
# GOVERNMENT SECURITY CONNECTORS
# ------------------------------------------------------------------------------
GOVSEC_CONNECTORS="ADVISORIES,SECURITY_BULLETINS,PUBLIC_REPORTS,OPEN_ALERTS,VULNERABILITY_NOTICES,REGULATORY_PUBLICATIONS"

# ------------------------------------------------------------------------------
# EXTERNAL REGISTRY NORMALIZATION
# ------------------------------------------------------------------------------
EXTERNAL_REGISTRY_NASD_STATUS="UNRESOLVED_EXTERNAL_REGISTRY"
EXTERNAL_REGISTRY_CAID_STATUS="UNRESOLVED_EXTERNAL_REGISTRY"
EXTERNAL_REGISTRY_UNRD_STATUS="UNRESOLVED_EXTERNAL_REGISTRY"

# ------------------------------------------------------------------------------
# GDELT EVENT INTELLIGENCE PIPELINE
# ------------------------------------------------------------------------------
GDELT_PIPELINE_ENABLED="true"

# ------------------------------------------------------------------------------
# GEOINT DATA PROCESSING
# ------------------------------------------------------------------------------
GEOINT_PIPELINE_ENABLED="true"

# ------------------------------------------------------------------------------
# AI / DATA SCIENCE PROCESSING LAYER
# ------------------------------------------------------------------------------
AI_ANALYTICS_PIPELINE_ENABLED="true"

# ------------------------------------------------------------------------------
# DATA QUALITY AND GOVERNANCE
# ------------------------------------------------------------------------------
DATA_GOVERNANCE_ENFORCED="true"
