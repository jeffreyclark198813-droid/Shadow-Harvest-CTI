rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jeffreyclark198813@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // specific collection matches
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && (request.resource.data.role == resource.data.role);
      
      match /personas/{personaId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /settings/{settingId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /ai_personas/{personaId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    }

    match /api_endpoints/{endpointId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || request.resource.data.createdBy == request.auth.uid);
    }

    match /api_sources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /intel_caches/{cacheId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /targets/{targetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      match /reports/{id} { allow read, write: if isSignedIn(); }
      match /threat_assessments/{id} { allow read, write: if isSignedIn(); }
      match /monitoring_events/{id} { allow read, write: if isSignedIn(); }
      match /narrative_events/{id} { allow read, write: if isSignedIn(); }
      match /persona_osint/{id} { allow read, write: if isSignedIn(); }
      match /persona_profiles/{id} { allow read, write: if isSignedIn(); }
      match /attribution_reports/{id} { allow read, write: if isSignedIn(); }
      match /synthesized_outputs/{id} { allow read, write: if isSignedIn(); }
      match /anomalies/{id} { allow read, write: if isSignedIn(); }
      match /recon_findings/{id} { allow read, write: if isSignedIn(); }
      match /threat_actor_profiles/{id} { allow read, write: if isSignedIn(); }
    }

    match /provenance/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /temporal_drifts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /hypotheses/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.createdBy == request.auth.uid);
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /quarantine/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /global_events/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /authority_policies/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /registry_identifiers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /federated_results/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
