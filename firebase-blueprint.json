{
  "entities": {
    "User": {
      "title": "User",
      "description": "Main user document.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin", "moderator", "user"] },
        "username": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "UserPersona": {
      "title": "User Persona",
      "description": "Custom hacker persona created by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "backstory": { "type": "string" },
        "stats": { "type": "object" },
        "privacySettings": { "type": "object" },
        "anonymityScore": { "type": "object" },
        "level": { "type": "number" },
        "xp": { "type": "number" }
      },
      "required": ["userId", "name"]
    },
    "UserSettings": {
      "title": "User Settings",
      "description": "Private settings and progression for a user.",
      "type": "object",
      "properties": {
        "activePersonaId": { "type": "string" },
        "role": { "type": "string" },
        "username": { "type": "string" },
        "stats": { "type": "object" },
        "achievements": { "type": "array" }
      }
    },
    "ApiEndpoint": {
      "title": "API Endpoint",
      "description": "Registered CTI API source.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "base_url": { "type": "string" },
        "classification_tag": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "createdBy"]
    },
    "Target": {
      "title": "Intelligence Target",
      "description": "A subject of investigation.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" },
        "userPersonaId": { "type": "string" }
      },
      "required": ["name", "createdBy"]
    },
    "IntelCache": {
      "title": "Intelligence Cache",
      "description": "Caches Gemini CTI synthesis results to prevent quota exhaustion.",
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "description": "The search term or context used for the analysis."
        },
        "data": {
          "type": "object",
          "description": "The synthesized intelligence data."
        },
        "timestamp": {
          "type": "number",
          "description": "The epoch timestamp when the cache was created."
        }
      },
      "required": ["context", "data", "timestamp"]
    },
    "ApiSource": {
      "title": "API Source",
      "description": "Public or shared intelligence API health feeds.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "endpoint": { "type": "string" },
        "status": { "type": "string" },
        "lastChecked": { "type": "object" }
      }
    },
    "Provenance": {
      "title": "Artifact Provenance",
      "description": "Cryptographic and lineage metadata for intelligence artifacts.",
      "type": "object",
      "properties": {
        "artifactId": { "type": "string" },
        "source": { "type": "string" },
        "hash": { "type": "string" }
      },
      "required": ["artifactId"]
    },
    "TemporalDrift": {
      "title": "Temporal Drift",
      "description": "Clock and timeline reconciliation logs for distributed sensors.",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "adjustedMs": { "type": "number" },
        "reconciledBy": { "type": "string" },
        "reconciledAt": { "type": "object" }
      }
    },
    "Hypothesis": {
      "title": "Investigation Hypothesis",
      "description": "Hypothesis evaluation for intelligence targets.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "createdBy": { "type": "string" },
        "currentConfidence": { "type": "number" },
        "trend": { "type": "array" }
      },
      "required": ["createdBy"]
    },
    "AuditLog": {
      "title": "Security Audit Log",
      "description": "Tamper-evident logs of system actions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["userId", "action"]
    },
    "GlobalEvent": {
      "title": "Global Event",
      "description": "Global or cross-target narrative broadcast events.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user profiles."
    },
    "/users/{userId}/personas/{personaId}": {
      "schema": "UserPersona",
      "description": "Personas owned by a specific user."
    },
    "/users/{userId}/settings/main": {
      "schema": "UserSettings",
      "description": "Main settings document for a user."
    },
    "/users/{userId}/ai_personas/{personaId}": {
      "schema": "UserPersona",
      "description": "AI-generated personas owned by the user."
    },
    "/api_endpoints/{endpointId}": {
      "schema": "ApiEndpoint",
      "description": "Registry of intelligence API endpoints."
    },
    "/targets/{targetId}": {
      "schema": "Target",
      "description": "Main targets collection."
    },
    "/targets/{targetId}/reports/{reportId}": {
      "schema": "IntelligenceReport",
      "description": "Intelligence reports associated with a target."
    },
    "/intel_caches/{cacheId}": {
      "schema": "IntelCache",
      "description": "Collection of cached threat intelligence reports."
    },
    "/api_sources/{sourceId}": {
      "schema": "ApiSource",
      "description": "Collection of active API feed health trackers."
    },
    "/provenance/{provenanceId}": {
      "schema": "Provenance",
      "description": "Provenance records for intelligence items."
    },
    "/temporal_drifts/{driftId}": {
      "schema": "TemporalDrift",
      "description": "Timeline synchronization and drift records."
    },
    "/hypotheses/{hypothesisId}": {
      "schema": "Hypothesis",
      "description": "Hypotheses created by analysts."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Security audit logs."
    },
    "/global_events/{eventId}": {
      "schema": "GlobalEvent",
      "description": "Global operational broadcast events."
    }
  }
}
