{
  "entities": {
    "Target": {
      "title": "Target",
      "description": "A digital entity or infrastructure asset under investigation.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The primary identifier (domain, username, alias)." },
        "type": { "type": "string", "enum": ["domain", "ip", "persona", "wallet"], "description": "The category of the target." },
        "status": { "type": "string", "enum": ["active", "pending", "archived"], "description": "Current investigation status." },
        "confidenceScore": { "type": "number", "description": "Overall confidence in the attribution." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID of the analyst." },
        "userPersonaId": { "type": "string", "description": "The ID of the user persona conducting this investigation." }
      },
      "required": ["name", "type", "status", "createdBy", "userPersonaId"]
    },
    "IntelligenceReport": {
      "title": "Intelligence Report",
      "description": "A detailed analytical report generated by Gemini or an analyst.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string", "description": "Reference to the Target entity." },
        "phase": { "type": "integer", "description": "The phase of the operation (1-5)." },
        "content": { "type": "string", "description": "Markdown content of the report." },
        "source": { "type": "string", "description": "The origin of the intelligence (e.g., SWI, DWI, DWkI)." },
        "timestamp": { "type": "string", "format": "date-time" },
        "confidence": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] }
      },
      "required": ["targetId", "phase", "content", "timestamp"]
    },
    "EntityNode": {
      "title": "Entity Node",
      "description": "A node in the intelligence graph.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "country": { "type": "string" }
          }
        },
        "metadata": { "type": "object" }
      },
      "required": ["targetId", "label", "type"]
    },
    "EntityEdge": {
      "title": "Entity Edge",
      "description": "A relationship between two nodes in the graph.",
      "type": "object",
      "properties": {
        "sourceId": { "type": "string" },
        "targetId": { "type": "string" },
        "relationship": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "required": ["sourceId", "targetId", "relationship"]
    },
    "ThreatAssessment": {
      "title": "Threat Assessment",
      "description": "An evaluation of a threat actor's capabilities and patterns.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "capabilities": { "type": "string" },
        "ttps": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "confidence": { "type": "number" },
              "explanation": { "type": "string" }
            }
          } 
        },
        "operationalScope": { "type": "string" },
        "potentialTargets": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "capabilities", "timestamp"]
    },
    "PersonaOSINT": {
      "title": "Persona OSINT",
      "description": "Open Source Intelligence gathered for a specific persona.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "personaId": { "type": "string" },
        "socialProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": { "type": "string" },
              "url": { "type": "string" },
              "description": { "type": "string" },
              "connectionsCount": { "type": "integer" },
              "recentPosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "personaId", "timestamp"]
    },
    "AdvancedPersonaProfile": {
      "title": "Advanced Persona Profile",
      "description": "A deep-dive profile including stylometrics and behavioral signatures.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "personaId": { "type": "string" },
        "identifiers": {
          "type": "object",
          "properties": {
            "usernames": { "type": "array", "items": { "type": "string" } },
            "emails": { "type": "array", "items": { "type": "string" } },
            "pgpFingerprints": { "type": "array", "items": { "type": "string" } },
            "wallets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "stylometricAnalysis": {
          "type": "object",
          "properties": {
            "writingStyle": { "type": "string" },
            "vocabulary": { "type": "string" },
            "sentiment": { "type": "string" }
          }
        },
        "behavioralSignature": {
          "type": "object",
          "properties": {
            "activityCadence": { "type": "string" },
            "timezoneInference": { "type": "string" },
            "operationalSecurity": { "type": "string" }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "personaId", "timestamp"]
    },
    "AttributionReport": {
      "title": "Attribution Report",
      "description": "A high-level report correlating all intelligence for threat contextualization.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "summary": { "type": "string" },
        "geotemporalAnalysis": { "type": "string" },
        "behavioralCorrelations": { "type": "string" },
        "confidenceScore": { "type": "number" },
        "likelyAttribution": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "summary", "confidenceScore", "timestamp"]
    },
    "MonitoringEvent": {
      "title": "Monitoring Event",
      "description": "A significant event detected by automated collection pipelines.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "type": { "type": "string", "enum": ["wallet_activity", "credential_leak", "infra_change", "forum_mention"] },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "dataHash": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "type", "description", "dataHash", "timestamp"]
    },
    "UserPersona": {
      "title": "User Persona",
      "description": "A unique character profile for the analyst.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "backstory": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "hacking": { "type": "integer" },
            "socialEngineering": { "type": "integer" },
            "cryptography": { "type": "integer" },
            "stealth": { "type": "integer" }
          }
        },
        "privacySettings": {
          "type": "object",
          "properties": {
            "vpnEnabled": { "type": "boolean" },
            "torRouting": { "type": "boolean" },
            "dataSharingLevel": { "type": "string", "enum": ["none", "minimal", "full"] },
            "encryptedStorage": { "type": "boolean" },
            "metadataScrubbing": { "type": "boolean" }
          }
        },
        "anonymityScore": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "breakdown": { "type": "object" }
          }
        },
        "level": { "type": "integer" },
        "xp": { "type": "integer" }
      },
      "required": ["userId", "name", "stats", "privacySettings"]
    },
    "UserSettings": {
      "title": "User Settings",
      "description": "Global settings for the user account.",
      "type": "object",
      "properties": {
        "activePersonaId": { "type": "string" }
      }
    },
    "NarrativeEvent": {
      "title": "Narrative Event",
      "description": "A dynamic event that impacts the narrative or gameplay.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["opportunity", "threat", "challenge"] },
        "impact": { "type": "string" },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "consequence": { "type": "string" }
            }
          }
        },
        "resolved": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "type", "timestamp"]
    },
    "AIPersona": {
      "title": "AI Persona",
      "description": "A custom AI persona definition for the intelligence engine.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "personality": { "type": "string" },
        "knowledgeDomains": { "type": "array", "items": { "type": "string" } },
        "tone": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "personality", "tone"]
    },
    "SynthesizedOutput": {
      "title": "Synthesized Output",
      "description": "A structured intelligence product generated from context.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "format": { "type": "string", "enum": ["summary", "report", "comparison"] },
        "content": { "type": "string" },
        "focusAreas": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "title", "format", "content", "timestamp"]
    },
    "Anomaly": {
      "title": "Anomaly",
      "description": "A detected deviation from baseline behavior in network, user, or financial data.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "type": { "type": "string", "enum": ["network", "user_activity", "financial"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string" },
        "evidence": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "resolved": { "type": "boolean" }
      },
      "required": ["targetId", "type", "severity", "description", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}/settings/main": {
      "schema": "UserSettings",
      "description": "Global settings for the user."
    },
    "/users/{userId}/personas/{personaId}": {
      "schema": "UserPersona",
      "description": "The personas for a user."
    },
    "/targets/{targetId}/narrative_events/{eventId}": {
      "schema": "NarrativeEvent",
      "description": "Narrative events linked to a target."
    },
    "/targets/{targetId}": {
      "schema": "Target",
      "description": "Main collection for investigation targets."
    },
    "/targets/{targetId}/reports/{reportId}": {
      "schema": "IntelligenceReport",
      "description": "Reports associated with a specific target."
    },
    "/targets/{targetId}/graph/nodes/{nodeId}": {
      "schema": "EntityNode",
      "description": "Graph nodes for a specific target's network."
    },
    "/targets/{targetId}/graph/edges/{edgeId}": {
      "schema": "EntityEdge",
      "description": "Graph edges for a specific target's network."
    },
    "/targets/{targetId}/threat_assessments/{assessmentId}": {
      "schema": "ThreatAssessment",
      "description": "Threat assessments for a specific target."
    },
    "/targets/{targetId}/monitoring_events/{eventId}": {
      "schema": "MonitoringEvent",
      "description": "Events detected by continuous monitoring pipelines."
    },
    "/targets/{targetId}/persona_osint/{osintId}": {
      "schema": "PersonaOSINT",
      "description": "OSINT data for personas associated with a target."
    },
    "/targets/{targetId}/persona_profiles/{profileId}": {
      "schema": "AdvancedPersonaProfile",
      "description": "Advanced profiling data for personas."
    },
    "/targets/{targetId}/attribution_reports/{reportId}": {
      "schema": "AttributionReport",
      "description": "Attribution and correlation engine outputs."
    },
    "/users/{userId}/ai_personas/{personaId}": {
      "schema": "AIPersona",
      "description": "Custom AI personas saved by the user."
    },
    "/targets/{targetId}/synthesized_outputs/{outputId}": {
      "schema": "SynthesizedOutput",
      "description": "Structured outputs generated from target intelligence."
    },
    "/targets/{targetId}/anomalies/{anomalyId}": {
      "schema": "Anomaly",
      "description": "Detected anomalies for a specific target."
    }
  }
}
